\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{c+c1}{\PYGZsh{} Compute the G matrix for a cubic polynomial model given vector z.}
\PYG{c+c1}{\PYGZsh{} z is a vector}
\PYG{c+c1}{\PYGZsh{} z is represented either as a 1D array or a 2D array column vector (z.shape[1] == 1)}
\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{ComputeG}\PYG{p}{(}\PYG{n}{z}\PYG{p}{)}\PYG{p}{:}
  \PYG{n}{n} \PYG{o}{=} \PYG{n}{z}\PYG{o}{.}\PYG{n}{shape}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{]}

  \PYG{c+c1}{\PYGZsh{}In case z is a 1D array}
  \PYG{k}{if} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{z}\PYG{o}{.}\PYG{n}{shape}\PYG{p}{)} \PYG{o}{==} \PYG{l+m+mi}{1}\PYG{p}{:}
    \PYG{n}{z} \PYG{o}{=} \PYG{n}{z}\PYG{o}{.}\PYG{n}{reshape}\PYG{p}{(}\PYG{n}{n}\PYG{p}{,}\PYG{l+m+mi}{1}\PYG{p}{)}

  \PYG{n}{G} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{concatenate}\PYG{p}{(}\PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{ones}\PYG{p}{(}\PYG{p}{(}\PYG{n}{n}\PYG{p}{,}\PYG{l+m+mi}{1}\PYG{p}{)}\PYG{p}{)}\PYG{p}{,} \PYG{n}{z}\PYG{p}{,} \PYG{n}{z}\PYG{o}{*}\PYG{o}{*}\PYG{l+m+mi}{2}\PYG{p}{,} \PYG{n}{z}\PYG{o}{*}\PYG{o}{*}\PYG{l+m+mi}{3}\PYG{p}{)}\PYG{p}{,} \PYG{n}{axis} \PYG{o}{=} \PYG{l+m+mi}{1}\PYG{p}{)}
  \PYG{k}{return} \PYG{n}{G}

\PYG{n}{z} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{arange}\PYG{p}{(}\PYG{l+m+mi}{11}\PYG{p}{)}
\PYG{n+nb}{print}\PYG{p}{(}\PYG{n}{ComputeG}\PYG{p}{(}\PYG{n}{z}\PYG{p}{)}\PYG{p}{)}
\end{MintedVerbatim}
